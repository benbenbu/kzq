 144          // 处理读离散输入请求
 145          void Modbus_HandleReadDiscreteInputs() {
 146   1          uint16_t i;
 147   1          uint16_t start_addr ;
 148   1          uint16_t num_inputs;
 149   1          uint8_t response[255];
 150   1          uint8_t byte_count; 
 151   1          uint16_t crc;
 152   1           start_addr = ((uint16_t)modbus_rx_buffer[2] << 8) | modbus_rx_buffer[3];
 153   1           num_inputs = ((uint16_t)modbus_rx_buffer[4] << 8) | modbus_rx_buffer[5];
 154   1          
 155   1          if(num_inputs > 0 && num_inputs <= 2000) { // Modbus限制
 156   2              // 计算需要的字节数
 157   2               byte_count = (num_inputs + 7) / 8;
 158   2              
 159   2              // 构造响应
 160   2      
 161   2              response[0] = modbus_slave_addr;
 162   2              response[1] = 0x02; // 功能码
 163   2              response[2] = byte_count; // 字节数
 164   2              
 165   2              // 填充离散输入数据（示例：全部为0）
 166   2      
 167   2              for(i = 0; i < byte_count; i++) {
 168   3                  response[3 + i] = 0x00; // 示例数据，实际应根据输入状态设置
 169   3              }
 170   2              
 171   2              // 计算CRC
 172   2              crc = Modbus_CRC16(response, 3 + byte_count);
 173   2              response[3 + byte_count] = crc & 0xFF;
 174   2              response[4 + byte_count] = (crc >> 8) & 0xFF;
 175   2              
 176   2              // 发送响应
 177   2              UART0_SendArray(response, 5 + byte_count);
