  28          // CRC16计算
  29          uint16_t Modbus_CRC16(uint8_t *pucBuff, uint8_t unNum) {
  30   1          uint16_t CRC_Value = 0;
  31   1          uint8_t  i         = 0;
  32   1          uint8_t  j         = 0;
  33   1      
  34   1          CRC_Value = 0xffff;
  35   1          for(i=0;i<unNum;i++)  //
  36   1          {
  37   2              CRC_Value ^= *(pucBuff+i);
  38   2              for(j=0;j<8;j++)
  39   2              {
  40   3                  if(CRC_Value & 0x00001)
  41   3                      CRC_Value = (CRC_Value >> 1) ^ 0xA001;
  42   3                  else
  43   3                      CRC_Value = (CRC_Value >> 1);
  44   3              }
  45   2          }
  46   1          CRC_Value = ((CRC_Value >> 8) +  (CRC_Value << 8)); //交换高低字节
  47   1      
  48   1          return CRC_Value;
  49   1      }
