 100          // 处理Modbus请求
 101          void Modbus_ProcessRequest() {
 102   1          if(modbus_rx_complete && modbus_rx_index >= 4) { // 最小Modbus帧长度
 103   2              uint8_t slave_addr = modbus_rx_buffer[0];
 104   2              
 105   2              // 检查从机地址
 106   2              if(slave_addr == modbus_slave_addr) {
 107   3                  uint8_t function_code = modbus_rx_buffer[1];
 108   3                  uint16_t crc_received = ((uint16_t)modbus_rx_buffer[modbus_rx_index-1] << 8) | 
 109   3                                         modbus_rx_buffer[modbus_rx_index-2];
 110   3                  
 111   3                  // 验证CRC
 112   3                  uint16_t crc_calculated = Modbus_CRC16(modbus_rx_buffer, modbus_rx_index-2);
 113   3                  
 114   3                  if(crc_received == crc_calculated) {
 115   4                      // CRC正确，处理功能码
C51 COMPILER V9.60.0.0   MODBUS                                                            12/11/2025 10:35:24 PAGE 3   

 116   4                      switch(function_code) {
 117   5                          case 0x02: // 读离散输入
 118   5                              Modbus_HandleReadDiscreteInputs();
 119   5                              break;
 120   5                          case 0x03: // 读保持寄存器
 121   5                              Modbus_HandleReadHoldingRegisters();
 122   5                              break;
 123   5                          case 0x04: // 读输入寄存器
 124   5                              Modbus_HandleReadInputRegisters();
 125   5                              break;
 126   5                          default:
 127   5                              // 不支持的功能码，发送错误响应
 128   5                              Modbus_SendError(function_code | 0x80, 0x01); // 非法功能
 129   5                              break;
 130   5                      }
 131   4                  } else {
 132   4                      // CRC错误，发送错误响应
 133   4                      Modbus_SendError(function_code | 0x80, 0x02); // CRC错误
 134   4                  }
 135   3              }
 136   2              
 137   2              // 重置接收状态
 138   2              modbus_rx_index = 0;
 139   2              modbus_rx_complete = 0;
 140   2              Modbus_StopTimeout();
 141   2          }
 142   1      }
