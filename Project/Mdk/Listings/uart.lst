 186          /* 极简版UART0_Start_Send（零拷贝专用，去掉拷贝循环） */
 187          uint8_t UART0_Start_Send(uint8_t len) {  // 仅传长度，不传buf
 188   1          unsigned char SFRPAGE_SAVE = SFRPAGE;
 189   1      
 190   1          /* 合法性校验 */
 191   1          if(tx_state == 1 || len == 0 || len > TX_BUF_SIZE) {
 192   2              return 1;
 193   2          }
 194   1      
 195   1          SFRPAGE = UART0_PAGE;
 196   1          EA = 0;
 197   1          tx_len = len;
 198   1          tx_index = 0;
 199   1          tx_state = 1;
 200   1          tx_complete_flag = 0;
 201   1          EA = 1;
 202   1      
 203   1          /* 切换485+发送第一个字节 */
 204   1          TX_EN = 1;
 205   1          _nop_();_nop_();_nop_();_nop_();
 206   1          SBUF0 = tx_buf[tx_index];
 207   1      
 208   1          SFRPAGE = SFRPAGE_SAVE;
 209   1          return 0;
 210   1      }
