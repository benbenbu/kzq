  32   1          SFRPAGE_SAVE = SFRPAGE; 
  33   1          SFRPAGE = UART0_PAGE;    
  34   1      
  35   1          /* 2. 停止定时器1，避免配置过程中触发 */
  36   1          TR1 = 0;
  37   1      
  38   1          /* 3. 禁能UART0并配置工作模式 */
  39   1      
