 217          /* 串口波特率适配：以9600为例，1位起始+8位数据+1位停止=10位/字节
 218             200字节发送耗时：200*10/9600 ≈ 208ms，仪表场景完全可接受 */
 219          void UART0_SendBuf_Block(uint8_t *buf, uint8_t len) {
 220   1          unsigned char SFRPAGE_SAVE = SFRPAGE; 
 221   1          uint8_t i;
 222   1      
 223   1          if(len == 0 || buf == NULL) return;
 224   1      
 225   1          SFRPAGE = UART0_PAGE; 
 226   1          // 1. 切换485为发送模式，延时确保切换完成（关键）
 227   1          TX_EN = 1;
 228   1          _nop_();_nop_();_nop_();_nop_();  // 多延时几个周期，适配485芯片
 229   1      
 230   1          // 2. 阻塞发送所有字节（仅一次循环，无冗余拷贝）
 231   1          for(i = 0; i < len; i++) {
 232   2              SBUF0 = buf[i];        // 直接发送原缓冲区数据，无拷贝
 233   2              while(!TI0);           // 等待单字节发送完成
 234   2              TI0 = 0;               // 清标志
 235   2          }
 236   1      
 237   1          // 3. 发送完成后，延时再切换485为接收（避免最后一字节被截断）
 238   1          _nop_();_nop_();_nop_();_nop_();
 239   1          TX_EN = 0;
C51 COMPILER V9.60.0.0   UART                                                              01/28/2026 08:24:07 PAGE 5   

 240   1      
 241   1          SFRPAGE = SFRPAGE_SAVE;
 242   1      }
