 247          /* ==================== 串口中断服务函数（接收+非阻塞发送） ==================== */
 248          void UART_ISR(void) interrupt 4 {
 249   1          uint8_t temp_data;
 250   1          unsigned char SFRPAGE_SAVE = SFRPAGE; 
 251   1           
 252   1          SFRPAGE = UART0_PAGE;     
 253   1          // ========== 接收中断处理（原有逻辑，保留） ==========
 254   1          if(RI0) {
 255   2              RI0 = 0;  // 清接收标志
 256   2              temp_data = SBUF0;  // 读取接收数据
 257   2              
 258   2              if(rx_state == 1 && rx_len < RX_BUF_SIZE) {
 259   3                  rx_buf[rx_len] = temp_data;
 260   3                  rx_len++;
 261   3                  rx_timeout_cnt = 0;  // 接收数据，重置超时计数器
 262   3              } else if(rx_state == 0) {
 263   3                  // 首次接收数据，启动接收
 264   3                  rx_state = 1;
 265   3                  rx_len = 0;
 266   3                  rx_buf[rx_len] = temp_data;
 267   3                  rx_len++;
 268   3                  rx_timeout_cnt = 0;
 269   3              }
 270   2          }
 271   1          
 272   1          // ========== 发送中断处理（修正核心逻辑） ==========
 273   1          if(TI0) {
 274   2              TI0 = 0;  // 清发送标志
 275   2              
 276   2              // 仅当处于发送状态时，处理下一字节（关键！）
 277   2              if(tx_state == 1) {
 278   3                  tx_index++;  // 索引自增，指向下一字节
 279   3                  if(tx_index < tx_len) {
 280   4                      // 还有数据要发，发送下一字节
 281   4                      SBUF0 = tx_buf[tx_index];
 282   4                  } else {
 283   4                      // 发送完成：恢复485为接收模式，重置发送状态
 284   4                      TX_EN = 0;
 285   4                      tx_state = 0;
 286   4                      tx_index = 0;
 287   4                      tx_len = 0;
 288   4                      tx_complete_flag=1;
 289   4                  }
 290   3              }
 291   2              // 非发送状态：仅清标志，不做任何操作
 292   2          }
 293   1          SFRPAGE = SFRPAGE_SAVE;
 294   1      }


