  43   1          // 公式：temp = SYSCLK / (12 * 32 * 波特率)
  44   1          // 注：SYSCLK需在代码中提前定义（如#define SYSCLK 11059200UL）
  45   1          temp = (SYSCLK / (12UL * 32UL * uart_baudrate));
