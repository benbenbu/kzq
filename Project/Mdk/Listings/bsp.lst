  95          // 看门狗配置函数 - 设置溢出时间
  96          void Watchdog_Config(unsigned char timeout_setting)
  97          {
  98   1          // 设置看门狗超时间隔
  99   1          // 超时间隔 = 4^(3+WDTCN[2:0]) × TSYSCLK
 100   1          // WDTCN[2:0]的值范围是0-7
 101   1          
 102   1          // 直接写入超时间隔设置
 103   1          // 注意：写入此值不会立即生效，需要喂狗命令才能生效
 104   1        
 105   1        
 106   1          WDTCN = timeout_setting & 0x07;  // 只使用低3位设置超时间隔
 107   1      }
 108          
 109          // 看门狗使能函数 - 使能并配置看门狗
 110          void Watchdog_Enable(unsigned char timeout_setting)
 111          {
 112   1          // 先配置超时间隔
 113   1          Watchdog_Config(timeout_setting);
 114   1          
 115   1          // 然后使能看门狗（喂狗操作）
