 119          // 看门狗禁用函数
 120          void Watchdog_Disable(void)
 121          {
 122   1      //    uint8_t i;
 123   1          EA=0;
 124   1          // 禁用看门狗定时器
 125   1          // 需要两步序列：0xDE + 0xAD，在4个系统周期内完成
 126   1          WDTCN = 0xDE;  // 第一步
 127   1          WDTCN = 0xAD;  // 第二步（必须在4个系统周期内）
 128   1      //    EA=1;
 129   1      }
 130          
 131          // 看门狗锁定函数 - 永久禁用看门狗
 132          void Watchdog_Lock(void)
 133          {
 134   1          // 锁定看门狗禁用功能，永久禁用
 135   1          // 一旦执行此操作，无法再启用看门狗
