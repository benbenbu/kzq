  69          void Port_Init(void) {
  70   1          unsigned char SFRPAGE_SAVE = SFRPAGE; // 保存当前SFR页（C89兼容，char→unsigned char避免符号问题）
  71   1          SFRPAGE = CONFIG_PAGE;               // 切换到配置页（端口/交叉开关配置必须此页）
  72   1      
  73   1          // ========== 1. 配置引脚输出模式（PnMDOUT） ==========
  74   1          // 原有配置保留
  75   1          P0MDOUT |= 0x95;  // P0.2(MOSI)、P0.4(SCK) 推挽输出,END输出，TX输出
  76   1          P1MDOUT = 0xf7;   // P1口控制信号（RST/CD/CS0/WR/OE）=推挽（强驱动）
  77   1          P2MDOUT = 0xFF;   // P2口数据总线=推挽（数据传输需强驱动）  
  78   1          P3MDOUT |= 0xFF;  // P3口全推挽输出（保留原有配置）
  79   1      
  80   1          // 补充P4配置：P4.0~P4.5=输入（bit0~bit5=0）、P4.6~P4.7=输出（bit6~bit7=1）
  81   1          P4MDOUT = 0xC0;   // 0xC0=11000000 → P4.6/P4.7推挽输出，其余输入
  82   1          // P5/P6/P7全输出：推挽模式（0xFF=所有bit=1）
  83   1          P5MDOUT = 0xFF;   // P5口全推挽输出
  84   1          P6MDOUT = 0xFF;   // P6口全推挽输出
  85   1          P7MDOUT = 0xFF;   // P7口全推挽输出
  86   1      
  87   1          // ========== 2. 配置交叉开关功能映射（XBR0/XBR1/XBR2） ==========
  88   1          XBR0 = 0x07;      // 使能UART0(P0.0/P0.1)、SPI(P0.2/P0.3/P0.4)、IIC(P0.5/P0.6)
  89   1          XBR1 = 0x00;      // 无额外外设功能需要映射
  90   1          XBR2 = 0x40;      // 使能交叉开关（XBARE=1）→ 所有GPIO功能生效的核心配置
  91   1      
  92   1          // ========== 3. 配置端口初始电平（避免上电电平不确定） ==========
  93   1          P0 |= 0x08;       // P0.3(MISO)设为输入电平（高阻）
  94   1          P1 = 0X08;        // P1口控制信号初始低电平，p13输入
  95   1          P2 = 0x00;        // P2口数据总线初始低电平
  96   1          P3 = 0XFF;        // P3口初始电平（保留原有配置）
  97   1          P4 = 0X3F;        // P4=00111111 → P4.0~P4.5=1（输入上拉）、P4.6~P4.7=0（输出低电平）
  98   1          P5 = 0x00;        // P5口初始低电平（电容投切引脚初始复位）
  99   1          P6 = 0x00;        // P6口初始低电平（电容投切引脚初始复位）
 100   1          P7 = 0x00;        // P7口初始低电平（电容投切引脚初始复位）
 101   1          LED_RUN=0;
 102   1          SFRPAGE = SFRPAGE_SAVE; // 恢复原SFR页（必须！否则后续寄存器操作会出错）
 103   1      }
