  36          // 系统时钟初始化
  37          void ExternalClock_Init(void)
  38          {
  39   1          char SFRPAGE_SAVE = SFRPAGE; // 保存当前SFR页
  40   1          SFRPAGE = CONFIG_PAGE;       // 切换到配置页 (0x01)
  41   1      
  42   1          // 关键：22.1184MHz 晶振标准配置 (OSCXCN = 0x67)
  43   1          OSCXCN = 0x67;               // 0b01100111: 
  44   1                                       //   EXTEN=1, XTAL=1, OSCEN=1, XFCN=1
  45   1          while (!(OSCXCN & 0x80));    // 等待外部振荡器稳定 (OSCSTB=1)
  46   1      
  47   1          CLKSEL = 0x01;               // 选择外部时钟源 (CLKSEL.0=1)
  48   1      
  49   1          SFRPAGE = SFRPAGE_SAVE;      // 恢复SFR页
  50   1      }
