 127          // 看门狗禁用函数
 128          void Watchdog_Disable(void)
 129          {
 130   1      //    uint8_t i;
 131   1          EA=0;
 132   1          // 禁用看门狗定时器
 133   1          // 需要两步序列：0xDE + 0xAD，在4个系统周期内完成
