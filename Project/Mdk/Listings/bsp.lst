 119          // GPIO配置函数
 120          void GPIO_Config(unsigned char port, unsigned char pin, unsigned char mode) {
 121   1          switch(port) {
 122   2              case 0:
 123   2                  if(mode == 1) P0MDOUT |= (1 << pin); // 输出
 124   2                  else P0MDOUT &= ~(1 << pin);         // 输入
 125   2                  break;
 126   2              case 1:
 127   2                  if(mode == 1) P1MDOUT |= (1 << pin);
 128   2                  else P1MDOUT &= ~(1 << pin);
 129   2                  break;
 130   2              case 2:
 131   2                  if(mode == 1) P2MDOUT |= (1 << pin);
 132   2                  else P2MDOUT &= ~(1 << pin);
 133   2                  break;
 134   2              case 3:
 135   2                  if(mode == 1) P3MDOUT |= (1 << pin);
 136   2                  else P3MDOUT &= ~(1 << pin);
 137   2                  break;
 138   2          }
 139   1      }
 140          
 141          // GPIO输出函数
 142          void GPIO_Write(unsigned char port, unsigned char pin, unsigned char value) {
 143   1          switch(port) {
 144   2              case 0:
 145   2                  if(value) P0 |= (1 << pin);
 146   2                  else P0 &= ~(1 << pin);
 147   2                  break;
 148   2              case 1:
 149   2                  if(value) P1 |= (1 << pin);
 150   2                  else P1 &= ~(1 << pin);
 151   2                  break;
 152   2              case 2:
 153   2                  if(value) P2 |= (1 << pin);
 154   2                  else P2 &= ~(1 << pin);
 155   2                  break;
 156   2              case 3:
 157   2                  if(value) P3 |= (1 << pin);
 158   2                  else P3 &= ~(1 << pin);
 159   2                  break;
 160   2          }
 161   1      }
 162          
 163          // GPIO读取函数
 164          unsigned char GPIO_Read(unsigned char port, unsigned char pin) {
 165   1          switch(port) {
 166   2              case 0: return (P0 & (1 << pin)) ? 1 : 0;
 167   2              case 1: return (P1 & (1 << pin)) ? 1 : 0;
 168   2              case 2: return (P2 & (1 << pin)) ? 1 : 0;
 169   2              case 3: return (P3 & (1 << pin)) ? 1 : 0;
 170   2              default: return 0;
 171   2          }
 172   1      }
