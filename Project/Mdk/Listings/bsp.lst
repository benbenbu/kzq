 135   1          WDTCN = 0xAD;  // 第二步（必须在4个系统周期内）
 136   1      //    EA=1;
 137   1      }
 138          
 139          // 看门狗锁定函数 - 永久禁用看门狗
 140          void Watchdog_Lock(void)
 141          {
 142   1          // 锁定看门狗禁用功能，永久禁用
 143   1          // 一旦执行此操作，无法再启用看门狗
 144   1          WDTCN = 0xFF;  // 锁定禁用功能
 145   1      }
 146          
 147          // 喂狗函数 - 重置看门狗计数器
 148          void Watchdog_Feed(void)
 149          {
 150   1          // 喂狗操作，重置看门狗计数器
 151   1          // 命令：0xA5 - 使能并重装载WDT
 152   1          WDTCN = 0xA5;  // 使能并重装载WDT（喂狗）
