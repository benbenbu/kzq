  62          // 看门狗配置函数 - 设置溢出时间
  63          void Watchdog_Config(unsigned char timeout_setting)
  64          {
  65   1          // 设置看门狗超时间隔
  66   1          // 超时间隔 = 4^(3+WDTCN[2:0]) × TSYSCLK
  67   1          // WDTCN[2:0]的值范围是0-7
  68   1          
  69   1          // 直接写入超时间隔设置
  70   1          // 注意：写入此值不会立即生效，需要喂狗命令才能生效
  71   1          WDTCN = timeout_setting & 0x07;  // 只使用低3位设置超时间隔
  72   1      }
  73          
  74          // 看门狗使能函数 - 使能并配置看门狗
  75          void Watchdog_Enable(unsigned char timeout_setting)
  76          {
  77   1          // 先配置超时间隔
  78   1          Watchdog_Config(timeout_setting);
  79   1          
  80   1          // 然后使能看门狗（喂狗操作）
  81   1          WDTCN = 0xA5;  // 使能并重装载WDT
  82   1      }
  83          
  84          // 看门狗禁用函数
  85          void Watchdog_Disable(void)
  86          {
  87   1          EA=0;
  88   1          // 禁用看门狗定时器
  89   1          // 需要两步序列：0xDE + 0xAD，在4个系统周期内完成
  90   1          WDTCN = 0xDE;  // 第一步
  91   1          WDTCN = 0xAD;  // 第二步（必须在4个系统周期内）
  92   1          EA=1;
  93   1      }
  94          
  95          // 看门狗锁定函数 - 永久禁用看门狗
  96          void Watchdog_Lock(void)
  97          {
  98   1          // 锁定看门狗禁用功能，永久禁用
  99   1          // 一旦执行此操作，无法再启用看门狗
 100   1          WDTCN = 0xFF;  // 锁定禁用功能
 101   1      }
 102          
 103          // 喂狗函数 - 重置看门狗计数器
 104          void Watchdog_Feed(void)
 105          {
 106   1          // 喂狗操作，重置看门狗计数器
 107   1          // 命令：0xA5 - 使能并重装载WDT
 108   1          WDTCN = 0xA5;  // 使能并重装载WDT（喂狗）
 109   1      }
