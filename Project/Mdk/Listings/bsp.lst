 105          // 看门狗配置函数 - 设置溢出时间
 106          void Watchdog_Config()
 107          {
 108   1          // 设置看门狗超时间隔
 109   1          // 超时间隔 = 4^(3+WDTCN[2:0]) × TSYSCLK
 110   1          // WDTCN[2:0]的值范围是0-7
 111   1          
 112   1          // 直接写入超时间隔设置
 113   1          // 注意：写入此值不会立即生效，需要喂狗命令才能生效
 114   1        
 115   1        
