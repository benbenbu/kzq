 119          // 看门狗使能函数 - 使能并配置看门狗
 120          void Watchdog_Enable()
 121          {
 122   1          // 先配置超时间隔 
 123   1          // 然后使能看门狗（喂狗操作）
 124   1          WDTCN = 0xA5;  // 使能并重装载WDT
