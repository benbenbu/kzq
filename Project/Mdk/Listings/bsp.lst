  19          // 系统时钟初始化
  20          void ExternalClock_Init(void)
  21          {
  22   1          char SFRPAGE_SAVE = SFRPAGE; // 保存当前SFR页
  23   1          SFRPAGE = CONFIG_PAGE;       // 切换到配置页 (0x01)
  24   1      
  25   1          // 关键：22.1184MHz 晶振标准配置 (OSCXCN = 0x67)
  26   1          OSCXCN = 0x67;               // 0b01100111: 
  27   1                                       //   EXTEN=1, XTAL=1, OSCEN=1, XFCN=1
  28   1          while (!(OSCXCN & 0x80));    // 等待外部振荡器稳定 (OSCSTB=1)
  29   1      
  30   1          CLKSEL = 0x01;               // 选择外部时钟源 (CLKSEL.0=1)
  31   1      
  32   1          SFRPAGE = SFRPAGE_SAVE;      // 恢复SFR页
  33   1      }
  34          
  35          // 端口初始化
  36          void Port_Init() {
  37   1        
  38   1      
  39   1          char SFRPAGE_SAVE = SFRPAGE; // Save Current SFR page
  40   1      
  41   1          SFRPAGE = CONFIG_PAGE;
  42   1      
  43   1          // 2. 配置 P1 口 (控制信号)
  44   1          //    P1.0 (RST), P1.1 (CD), P1.2 (CS0), P1.4   (WR) → P1.7   (LVC245 OE)       推挽输出
  45   1          P1MDOUT = 0xff;  // 0x16 = 0b00010110 → 设置位 0,1,2,4 为 1 (推挽输出)
  46   1          
  47   1          // 3. 配置 P2 口 (数据总线 + RD 信号)
  48   1          P2MDOUT = 0xFF;   // 0xFF = 0b11111111 → 所有位推挽输出
  49   1        
  50   1      
  51   1      //    XBR0 = 0x06;  //  使能串口0 分配到IO口P0.0 P0.1      04    //    06
  52   1      //    XBR2 = 0x40;  
  53   1        
C51 COMPILER V9.60.0.0   BSP                                                               12/11/2025 10:35:24 PAGE 2   

  54   1            XBR0 = 0x00;  // 禁止所有数字外设引脚
  55   1          XBR1 = 0x00;  // 禁止所有数字外设引脚
  56   1          XBR2 = 0x40;  // 使能交叉开关，但不分配任何外设功能
  57   1          P1=0X00;
  58   1          P2 = 0x00;  // 清空数据总线
  59   1          SFRPAGE = SFRPAGE_SAVE;      // 恢复SFR页
  60   1      }
