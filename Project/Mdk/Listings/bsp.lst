  39          // 系统时钟初始化
  40          void ExternalClock_Init(void)
  41          {
  42   1          char SFRPAGE_SAVE = SFRPAGE; // 保存当前SFR页
  43   1          SFRPAGE = CONFIG_PAGE;       // 切换到配置页 (0x01)
  44   1      
  45   1          // 关键：22.1184MHz 晶振标准配置 (OSCXCN = 0x67)
  46   1          OSCXCN = 0x67;               // 0b01100111: 
  47   1                                       //   EXTEN=1, XTAL=1, OSCEN=1, XFCN=1
  48   1          while (!(OSCXCN & 0x80));    // 等待外部振荡器稳定 (OSCSTB=1)
  49   1      
  50   1          CLKSEL = 0x01;               // 选择外部时钟源 (CLKSEL.0=1)
  51   1      
  52   1          SFRPAGE = SFRPAGE_SAVE;      // 恢复SFR页
  53   1      }
