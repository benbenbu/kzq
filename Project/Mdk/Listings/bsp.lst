  66          // 端口初始化
  67          void Port_Init() {
  68   1        char SFRPAGE_SAVE = SFRPAGE; // 保存当前SFR页（C8051F多页寄存器机制）
  69   1          SFRPAGE = CONFIG_PAGE;       // 切换到配置页（端口/交叉开关配置必须此页）
  70   1      
  71   1          // 1. 配置引脚输出方式（PnMDOUT）
  72   1          P0MDOUT |= 0x95;  // P0.2(MOSI)、P0.4(SCK) 推挽输出,END输出，TX输出
  73   1      
  74   1          P1MDOUT = 0xff;  // P1口控制信号（RST/CD/CS0/WR/OE）=推挽（强驱动）
  75   1          P2MDOUT = 0xFF;  // P2口数据总线=推挽（数据传输需强驱动） 
  76   1          P3MDOUT |= 0xFF;   // 
  77   1          P4MDOUT |= 0xC0;   //
  78   1          P4=0X3F;//P46，P47输出，其他输入
  79   1          // 2. 配置交叉开关功能映射（XBR0/XBR1）
  80   1          XBR0 = 0x07;      // 使能UART0(P0.0/P0.1)、SPI(P0.2/P0.3/P0.4)、IIC(P0.5/P0.6)
  81   1          XBR1 = 0x00;      // 无额外外设功能需要映射
  82   1      
  83   1          // 3. 最后使能交叉开关（XBARE=1）
  84   1          XBR2 = 0x40;      // 
  85   1      
  86   1          // 4. 配置端口初始电平（避免上电后引脚电平不确定）
  87   1          P0 |= 0x08;        // 设置P0.3 Miso为输入
  88   1          P1 = 0X00;        // 控制信号初始低电平（可根据硬件需求调整，如RST需高电平则改为0xFF）
  89   1          P2 = 0x00;        // 数据总线初始低电平（清空总线，避免误读）
  90   1          P3 = 0X0f;
  91   1      
  92   1          SFRPAGE = SFRPAGE_SAVE;      // 恢复原SFR页
  93   1      }
