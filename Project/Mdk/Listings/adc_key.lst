 265          /*
 266          *********************************************************************************************************
 267          *   函 数 名: bsp_DetectKey
 268          *   功能说明: 检测单个按键状态（带去抖、长按、连发）
 269          *   修改说明: 使用标准递增/递减去抖，避免突变
 270          */
 271          static void bsp_DetectKey(uint8_t i) {
 272   1          KEY_T *pBtn = &s_tBtn[i];
 273   1          uint8_t press = pBtn->IsKeyDownFunc();
 274   1      
 275   1          if (press) {
 276   2              if (pBtn->Count < KEY_FILTER_TIME) {
 277   3                  pBtn->Count++;  // 逐步增加，直到达到阈值
 278   3              }
 279   2      
 280   2              if (pBtn->Count == KEY_FILTER_TIME) {
 281   3                  // 首次确认按下
 282   3                  if (pBtn->State == 0) {
 283   4                      pBtn->State = 1;
 284   4                      pBtn->LongCount = 0;
 285   4                      pBtn->RepeatCount = 0;
 286   4                      bsp_PutKey((uint8_t)(3 * i + 1));  // KEY_X_DOWN
 287   4                  }
 288   3      
 289   3                  // 长按处理
 290   3                  if (pBtn->LongTime > 0) {
 291   4                      if (++pBtn->LongCount >= pBtn->LongTime) {
 292   5                          pBtn->LongCount = pBtn->LongTime;  // 防溢出
 293   5                          // 触发长按事件（只发一次）
 294   5                          if ((pBtn->RepeatSpeed == 0) || 
