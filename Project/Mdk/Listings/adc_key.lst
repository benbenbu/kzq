C51 COMPILER V9.60.0.0   ADC_KEY                                                           01/28/2026 08:24:07 PAGE 6   

 296   6                              bsp_PutKey((uint8_t)(3 * i + 3));  // KEY_X_LONG
 297   6                          }
 298   5                      }
 299   4      
 300   4                      // 连发处理
 301   4                      if (pBtn->RepeatSpeed > 0) {
 302   5                          if (++pBtn->RepeatCount >= pBtn->RepeatSpeed) {
 303   6                              pBtn->RepeatCount = 0;
 304   6                              bsp_PutKey((uint8_t)(3 * i + 2));  // 连发 DOWN
 305   6                          }
 306   5                      }
 307   4                  }
 308   3              }
 309   2          } else {
 310   2              if (pBtn->Count > 0) {
 311   3                  pBtn->Count--;  // 逐步减少
 312   3              }
 313   2      
 314   2              if (pBtn->Count == 0) {
 315   3                  if (pBtn->State == 1) {
 316   4                      pBtn->State = 0;
 317   4                      bsp_PutKey((uint8_t)(3 * i + 2));  // KEY_X_UP
 318   4                  }
 319   3                  pBtn->LongCount = 0;
 320   3                  pBtn->RepeatCount = 0;
 321   3              }
 322   2          }
 323   1      }
