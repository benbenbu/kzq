 386   3              }
 387   2      
 388   2              // ========== 步骤6：根据表决结果更新全局状态 ==========
 389   2              // 全局状态位映射：I1→IO1_STATE(bit0)，I2→IO2_STATE(bit1)...I11→IO11_STATE(bit10)
 390   2              io_state_bit = (1 << i);
 391   2              if (low_count >= VOTE_THRESHOLD)
 392   2              {
 393   3                  // 多数为低电平（光耦导通，有输入）→ 置位全局状态
 394   3                  g_all_io_state |= io_state_bit;
 395   3              }
 396   2              else if (high_count >= VOTE_THRESHOLD)
 397   2              {
 398   3                  // 多数为高电平（光耦断开，无输入）→ 清零全局状态
 399   3                  g_all_io_state &= ~io_state_bit;
 400   3              }
 401   2              // 若高/低都不足3次（如2高3低则走low分支，2低3高走high分支；若2高2低1未知，保持原状态）
 402   2          }
 403   1      }


