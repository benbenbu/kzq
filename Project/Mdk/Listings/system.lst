 323          /**
 324           * @brief  读取所有11个输入IO状态（交直流光耦通用，5次3次多数表决，抗交流零点波动）
 325           * @note   主循环/定时器50ms调用1次，仅写满5次缓冲区后才表决，避免单次执行触发状态变化
 326           * @retval 无
 327           */
 328          void Read_All_IO_State(void)
 329          {
 330   1          // 1. 静态变量扩展：增加缓冲区写满标记（每个IO独立）
 331   1          static uint8_t io_history[IO_NUM][VOTE_WINDOW_SIZE] = {0};    // 每个IO最近5次电平
 332   1          static uint8_t io_ptr[IO_NUM] = {0};                          // 每个IO的缓冲区指针（0~4）
 333   1          static uint8_t io_buf_full[IO_NUM] = {0};                     // 0=未写满，1=已写满5次
 334   1          // 2. 临时变量
 335   1          uint8_t io_level[IO_NUM] = {0};    // 每个IO的当前原始电平（0=低，1=高）
 336   1          uint8_t high_count, low_count;     // 每个IO的高/低电平计数
 337   1          uint8_t i, j;                      // 循环变量
 338   1          unsigned char SFRPAGE_SAVE = SFRPAGE; // 51单片机SFR页保护（C89兼容）
 339   1          uint16_t io_state_bit = 0;    
 340   1      
 341   1          // ========== 步骤1：读取原始IO电平（光耦实时状态，含交流波动） ==========
 342   1          SFRPAGE = CONFIG_PAGE;  // 切换到配置页（根据硬件调整）
 343   1          // 逐个读取I1~I11的原始电平，转换为0（低）/1（高）
 344   1          io_level[0] = (I1 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;   // I1
 345   1          io_level[1] = (I2 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;   // I2
 346   1          io_level[2] = (I3 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;   // I3
 347   1          io_level[3] = (I4 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;   // I4
 348   1          io_level[4] = (I5 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;   // I5
 349   1          io_level[5] = (I6 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;   // I6
 350   1          io_level[6] = (I7 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;   // I7
 351   1          io_level[7] = (I8 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;   // I8
 352   1          io_level[8] = (I9 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;   // I9
 353   1          io_level[9] = (I10 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL;  // I10
 354   1          io_level[10] = (I11 == IO_VALID_LEVEL) ? LOW_LEVEL : HIGH_LEVEL; // I11
 355   1          SFRPAGE = SFRPAGE_SAVE; // 恢复SFR页（必须，防止后续寄存器操作出错）
 356   1      
 357   1          // ========== 步骤2：每个IO独立更新历史缓冲区（环形） ==========
 358   1          for (i = 0; i < IO_NUM; i++)
 359   1          {
 360   2              // 写入当前电平到环形缓冲区（覆盖最旧的记录）
 361   2              io_history[i][io_ptr[i]] = io_level[i];
 362   2              // 指针循环（0→1→2→3→4→0）
 363   2              io_ptr[i] = (io_ptr[i] + 1) % VOTE_WINDOW_SIZE;
C51 COMPILER V9.60.0.0   SYSTEM                                                            01/28/2026 08:24:05 PAGE 7   

 364   2      
 365   2              // ========== 步骤3：标记缓冲区是否写满（仅第一次写满时置1） ==========
 366   2              if (io_ptr[i] == 0 && io_buf_full[i] == 0)
 367   2              {
 368   3                  io_buf_full[i] = 1; // 指针回到0，说明已写满5次，标记为完成初始化
 369   3              }
 370   2      
 371   2              // ========== 步骤4：仅缓冲区写满后，才进行多数表决 ==========
 372   2              if (io_buf_full[i] == 0)
