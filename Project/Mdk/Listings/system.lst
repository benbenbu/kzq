  75          /*
  76          *********************************************************************************************************
  77          *   函 数 名: UpdateAdcFilter
  78          *   功能说明: 优化的中值滤波（5点中值，抗干扰更强）
  79          *********************************************************************************************************
  80          */
  81          static void UpdateAdcFilter(void) {
  82   1          unsigned int temp;
  83   1          // 核心修改：缓冲区改为static，避免栈溢出（51栈空间小）
  84   1          static unsigned int buf[ADC_SAMPLE_BUF_SIZE];
  85   1          uint8_t i,j;
  86   1      
  87   1          // 1. 复制数据（临界区：仅复制时关中断，排序不关）
  88   1          EA = 0;
  89   1          for ( i = 0; i < ADC_SAMPLE_BUF_SIZE; i++) {
  90   2              buf[i] = g_adc_raw_values[i];
  91   2          }
  92   1          EA = 1; // 立即开中断，避免丢失ADC采样
  93   1      
  94   1          // 2. 冒泡排序（开中断执行，不影响采样）
  95   1          for ( i = 0; i < ADC_SAMPLE_BUF_SIZE - 1; i++) {
  96   2              for ( j = 0; j < ADC_SAMPLE_BUF_SIZE - i - 1; j++) {
  97   3                  if (buf[j] > buf[j + 1]) {
  98   4                      temp = buf[j];
  99   4                      buf[j] = buf[j + 1];
 100   4                      buf[j + 1] = temp;
 101   4                  }
 102   3              }
 103   2          }
 104   1      
 105   1          // 3. 更新有效值（仅更新时关中断）
 106   1          EA = 0;
 107   1          g_adc_value = buf[ADC_SAMPLE_BUF_SIZE / 2];
 108   1          g_adc_data_valid = 1;
 109   1          EA = 1;
 110   1      }
