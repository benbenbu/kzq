 310          // 关键配置（适配交直流光耦，多数表决逻辑）
 311          #define IO_NUM             11      // 检测的IO总数（I1~I11）
 312          #define IO_VALID_LEVEL     0       // 输入有效电平（光耦导通=低电平）
 313          #define DETECT_INTERVAL_MS 50      // 检测间隔（50ms/次，主循环/定时器调用）
 314          #define VOTE_WINDOW_SIZE   5       // 表决窗口：最近5次检测结果
 315          #define VOTE_THRESHOLD     3       // 多数表决阈值：≥3次一致则确认状态
 316          #define HIGH_LEVEL         1       // 高电平标记
 317          #define LOW_LEVEL          0       // 低电平标记
