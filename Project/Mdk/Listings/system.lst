 374   3                  continue; // 未写满5次，跳过表决，全局状态保持不变
 375   3              }
 376   2      
 377   2              // ========== 步骤5：多数表决（统计最近5次中的高/低次数） ==========
 378   2              high_count = 0;
 379   2              low_count = 0;
 380   2              for (j = 0; j < VOTE_WINDOW_SIZE; j++)
 381   2              {
 382   3                  if (io_history[i][j] == HIGH_LEVEL)
 383   3                      high_count++;
 384   3                  else
