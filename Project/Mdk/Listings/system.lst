 112          void ADC0_ISR(void) interrupt 15 {
 113   1          unsigned int val;
 114   1           uint8_t is_valid_key_val = 0;
 115   1          if (AD0INT) {
C51 COMPILER V9.60.0.0   SYSTEM                                                            01/09/2026 10:58:01 PAGE 3   

 116   2              AD0INT = 0;
 117   2              val = (unsigned int)ADC0H << 8 | ADC0L;
 118   2      
 119   2              // 新增：先判断当前值是否在任意按键阈值窗口内（快速筛选有效值）
 120   2      
 121   2              if ((val >= THRESHOLD_KEY0 - THRESHOLD_WINDOW && val <= THRESHOLD_KEY0 + THRESHOLD_WINDOW) ||
 122   2                  (val >= THRESHOLD_KEY1 - THRESHOLD_WINDOW && val <= THRESHOLD_KEY1 + THRESHOLD_WINDOW) ||
 123   2                  (val >= THRESHOLD_KEY2 - THRESHOLD_WINDOW && val <= THRESHOLD_KEY2 + THRESHOLD_WINDOW) ||
 124   2                  (val >= THRESHOLD_KEY3 - THRESHOLD_WINDOW && val <= THRESHOLD_KEY3 + THRESHOLD_WINDOW) ||
 125   2                  (val >= THRESHOLD_KEY4 - THRESHOLD_WINDOW && val <= THRESHOLD_KEY4 + THRESHOLD_WINDOW) ||
 126   2                  (val >= THRESHOLD_KEY5 - THRESHOLD_WINDOW && val <= THRESHOLD_KEY5 + THRESHOLD_WINDOW)) {
 127   3                  is_valid_key_val = 1;
 128   3                  g_key_press_flag = 1;
 129   3              } else {
 130   3                  // 无键值：仅当按键标志已置1（松开阶段），才更新缓冲区（避免混值）
 131   3                  if (g_key_press_flag == 0) {
 132   4                      is_valid_key_val = 1;
 133   4                  } else {
 134   4                      // 按键松开：清空缓冲区，重置标志
 135   4                      s_adc_buf_index = 0;
 136   4                      g_key_press_flag = 0;
 137   4                      return; // 丢弃松开阶段的过渡值
 138   4                  }
 139   3              }
 140   2      
 141   2              // 仅有效值才存入缓冲区
 142   2              if (is_valid_key_val) {
 143   3                  EA = 0;
 144   3                  g_adc_raw_values[s_adc_buf_index] = val;
 145   3                  s_adc_buf_index++;
 146   3                  if (s_adc_buf_index >= ADC_SAMPLE_BUF_SIZE) {
 147   4                      s_adc_buf_index = 0;
 148   4                      UpdateAdcFilter();  // 缓冲区满则滤波
 149   4                  }
 150   3                  EA = 1;
 151   3              }
 152   2          }
 153   1      }
