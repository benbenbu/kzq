 194          /*
 195          *********************************************************************************************************
 196          *   函 数 名: UpdateAdcFilter
 197          *   功能说明: 优化的中值滤波（5点中值，抗干扰更强）
 198          *********************************************************************************************************
 199          */
 200          static void UpdateAdcFilter(void) {
 201   1          unsigned int temp;
 202   1          // 核心修改：缓冲区改为static，避免栈溢出（51栈空间小）
 203   1          static unsigned int buf[ADC_SAMPLE_BUF_SIZE];
 204   1          uint8_t i,j;
 205   1      
 206   1          // 1. 复制数据（临界区：仅复制时关中断，排序不关）
 207   1          EA = 0;
 208   1          for ( i = 0; i < ADC_SAMPLE_BUF_SIZE; i++) {
 209   2              buf[i] = g_adc_raw_values[i];
 210   2          }
 211   1          EA = 1; // 立即开中断，避免丢失ADC采样
 212   1      
 213   1          // 2. 冒泡排序（开中断执行，不影响采样）
 214   1          for ( i = 0; i < ADC_SAMPLE_BUF_SIZE - 1; i++) {
 215   2              for ( j = 0; j < ADC_SAMPLE_BUF_SIZE - i - 1; j++) {
 216   3                  if (buf[j] > buf[j + 1]) {
 217   4                      temp = buf[j];
 218   4                      buf[j] = buf[j + 1];
 219   4                      buf[j + 1] = temp;
 220   4                  }
 221   3              }
 222   2          }
 223   1      
 224   1          // 3. 更新有效值（仅更新时关中断）
 225   1          EA = 0;
 226   1          g_adc_value = buf[ADC_SAMPLE_BUF_SIZE / 2];
 227   1          g_adc_data_valid = 1;
 228   1          EA = 1;
 229   1      }
