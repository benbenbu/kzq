1291   1          /* 空指针保护 */
1292   1          if (event_buf == NULL) {
1293   2              return PARA_OP_ERR_NULL_PTR;
1294   2          }
1295   1      
1296   1          /* 获取当前事件索引（下次存储位置） */
1297   1          current_idx = Get_Event_Index();
1298   1      
1299   1          /* 循环读取最新20条（循环覆盖逻辑不变） */
1300   1          for (i = 0; i < 20; i++) {
1301   2              /* 计算读取索引：从最新的开始往前取，循环覆盖 */
