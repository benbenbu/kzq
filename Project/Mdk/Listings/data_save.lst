1092          static Para_Op_Result_E Update_Event_Index(uint8_t *index) {
1093   1          Para_Op_Result_E err;    
1094   1          *index = (*index + 1) % EVENT_LOG_CNT;  /* 循环自增：0→1→...→99→0 */
1095   1          err=FM31256_FRAM_Write(EVENT_INDEX_ADDR, index, 1);  /* 保存更新后的索引到FRAM */
1096   1          return err;
1097   1      }
