1110   1          /* 最新事件索引：当前索引为0→最新是99，否则为当前索引-1 */
1111   1          latest_idx = (current_idx == 0) ? (EVENT_LOG_CNT - 1) : (current_idx - 1);
1112   1      
1113   1          /* 读取最新事件记录 */
1114   1          err=FM31256_FRAM_Read(EVENT_LOG_ADDR(latest_idx), (uint8_t *)event_log, sizeof(Event_Log_Struct));
1115   1          
1116   1          if(err)
1117   1            return err;
1118   1          /* 事件类型为NONE→无有效事件，返回0；否则返回1 */
1119   1          return (event_log->event_type != EVENT_TYPE_NONE) ? EVENT_OK : EVENT_ERR;
1120   1      }
