1076          /**
1077           * @brief  写入系统事件记录（供其他模块调用，如故障、启动等事件）
1078           * @param  event_type：事件类型（枚举类型，如过压故障、系统启动等）
1079           * @param  event_data：事件关联数据（如故障码、参数值等，32位）
1080           * @return 无
1081           * @note   主程序按需调用，不主动触发则不写入新事件
1082           */
1083          Para_Op_Result_E Write_Event_Log(Event_Type_E event_type, uint32_t event_data) {
1084   1          Para_Op_Result_E err;      
1085   1          Event_Log_Struct event_log;  /* 事件记录结构体 */
1086   1          uint8_t event_idx = Get_Event_Index();  /* 获取当前事件存储索引 */
1087   1          memset(&event_log, 0, sizeof(Event_Log_Struct));  /* 结构体清零 */
1088   1      
1089   1          event_log.event_type = event_type;  /* 记录事件类型 */
1090   1          event_log.event_data = event_data;  /* 记录事件关联数据 */
1091   1          Fill_Event_Time(&event_log);        /* 填充事件发生时间 */
1092   1      
1093   1          /* 写入事件到FRAM，并更新事件索引 */
1094   1          err= FM31256_FRAM_Write(EVENT_LOG_ADDR(event_idx), (uint8_t *)&event_log, sizeof(Event_Log_Struct));
1095   1          Update_Event_Index(&event_idx);  /* 索引自增（循环覆盖） */
1096   1          return err;
1097   1      }
