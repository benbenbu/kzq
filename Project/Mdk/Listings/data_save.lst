 311          /**
 312           * @brief  获取指定年份和月份的天数（适配平年/闰年）
 313           * @param  year：完整年份（如2025）
 314           * @param  month：月份（1~12）
 315           * @return 当月天数（如2月：28或29天）
 316           */
 317          static uint8_t Get_MonthDays(uint16_t year, uint8_t month) {
 318   1          uint8_t month_days[] = {0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
 319   1          /* 2月且为闰年：返回29天，否则返回数组中定义的天数 */
 320   1          return (month == 2 && Is_LeapYear(year)) ? 29 : month_days[month];
 321   1      }
