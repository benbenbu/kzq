1283           */
1284          /* ==================== 读取最新20条事件记录（适配新结构体，无需补0） ==================== */
1285          Para_Op_Result_E Read_Latest_20_Event_Logs(Event_Log_Struct *event_buf) {
1286   1          /* C89：局部变量全部放在开头 */
1287   1          uint8_t current_idx;
