 319           * @return 当月天数（如2月：28或29天）
 320           */
 321          static uint8_t Get_MonthDays(uint16_t year, uint8_t month) {
 322   1          uint8_t month_days[] = {0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
 323   1          /* 2月且为闰年：返回29天，否则返回数组中定义的天数 */
 324   1          return (month == 2 && Is_LeapYear(year)) ? 29 : month_days[month];
 325   1      }
