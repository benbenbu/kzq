1032          /**
1033           * @brief  获取当前系统事件的存储索引
1034           * @param  无
1035           * @return 事件索引（0~EVENT_LOG_CNT-1）
1036           * @note   索引超出范围时，返回0（避免越界）
1037           */
1038           uint8_t Get_Event_Index(void) {
1039   1          uint8_t index = 0;
C51 COMPILER V9.60.0.0   DATA_SAVE                                                         01/09/2026 10:30:24 PAGE 18  

1040   1        
1041   1          FM31256_FRAM_Read(EVENT_INDEX_ADDR, &index, 1);  /* 从FRAM读取当前索引 */
1042   1          return (index >= EVENT_LOG_CNT) ? 0 : index;  /* 越界保护：返回0 */
1043   1      }
1044          
1045          /**
1046           * @brief  更新系统事件索引（支持循环覆盖）
1047           * @param  index：当前事件索引指针（输入+输出）
1048           * @return 无
1049           * @note   索引自增1，达到最大条数时重置为0（循环覆盖最早的事件）
1050           */
1051          static Para_Op_Result_E Update_Event_Index(uint8_t *index) {
1052   1          Para_Op_Result_E err;    
1053   1          *index = (*index + 1) % EVENT_LOG_CNT;  /* 循环自增：0→1→...→99→0 */
1054   1          err=FM31256_FRAM_Write(EVENT_INDEX_ADDR, index, 1);  /* 保存更新后的索引到FRAM */
1055   1          return err;
1056   1      }
1057          
1058          /**
1059           * @brief  填充事件记录的时间字段（原子读取当前时间）
1060           * @param  event_log：事件记录结构体指针（需填充时间）
1061           * @return 无
1062           * @note   原子读取：关闭总中断→复制全局时间→开启总中断，避免时间错乱
1063           */
1064          static void Fill_Event_Time(Event_Log_Struct *event_log) {
1065   1          if (event_log == NULL) return;  /* 空指针保护 */
1066   1          EA = 0;  /* 关闭总中断：确保读取过程中时间不被更新 */
1067   1          event_log->year   = BASE_YEAR + system_date.year;  /* 完整年份（如2025） */
1068   1          event_log->month  = system_date.month;             /* 月份（1~12） */
1069   1          event_log->day    = system_date.day;               /* 日期（1~31） */
1070   1          event_log->hour   = system_time.hour;              /* 小时（0~23） */
1071   1          event_log->minute = system_time.minute;            /* 分钟（0~59） */
1072   1          event_log->second = system_time.second;            /* 秒（0~59） */
1073   1          EA = 1;  /* 开启总中断：读取完成后恢复 */
1074   1      }
