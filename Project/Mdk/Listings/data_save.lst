C51 COMPILER V9.60.0.0   DATA_SAVE                                                         01/28/2026 08:24:06 PAGE 19  

1102           * @return 无
1103           * @note   原子读取：关闭总中断→复制全局时间→开启总中断，避免时间错乱
1104           */
1105          /**
1106           * @brief  填充事件记录的时间字段（原子读取当前时间，并转换为BCD码）
1107           * @param  event_log：事件记录结构体指针（需填充时间）
1108           * @return 无
1109           * @note   1. 原子读取：关闭总中断→复制全局时间→开启总中断，避免时间错乱；
1110           *         2. 系统时间规则：
1111           *            - system_date.year：2位十进制年份（25=2025，99=2099）；
1112           *            - system_date/month/day、system_time/hour/minute/second：十进制数值；
1113           *         3. 所有时间字段转换为BCD码后存储，适配Modbus通讯和FRAM存储规范；
1114           *         4. 依赖全局变量：system_date（年/月/日）、system_time（时/分/秒）
1115           */
1116          static void Fill_Event_Time(Event_Log_Struct *event_log) {
1117   1          /* C89：局部变量声明在函数开头（原子读取后缓存，避免中断恢复后数据变化） */
1118   1          uint8_t dec_year;    // 2位十进制年份（如25）
1119   1          uint8_t dec_month;   // 十进制月份（1~12）
1120   1          uint8_t dec_day;     // 十进制日期（1~31）
1121   1          uint8_t dec_hour;    // 十进制小时（0~23）
1122   1          uint8_t dec_minute;  // 十进制分钟（0~59）
1123   1          uint8_t dec_second;  // 十进制秒（0~59）
1124   1      
1125   1          /* 空指针保护：直接返回，避免非法访问 */
1126   1          if (event_log == NULL) {
1127   2              return;
1128   2          }
1129   1      
1130   1          /* 原子读取全局时间（关中断，避免时间字段跨值更新） */
1131   1          EA = 0;
1132   1          dec_year   = system_date.year;    // 直接读取2位十进制年份（无需取模）
1133   1          dec_month  = system_date.month;
1134   1          dec_day    = system_date.day;
1135   1          dec_hour   = system_time.hour;
1136   1          dec_minute = system_time.minute;
1137   1          dec_second = system_time.second;
1138   1          EA = 1;
1139   1      
1140   1          /* 十进制→BCD码转换，填充到事件结构体 */
1141   1          event_log->year   = DEC_TO_BCD(dec_year);    // 25→0x25（BCD）
1142   1          event_log->month  = DEC_TO_BCD(dec_month);   // 10→0x10（BCD）
1143   1          event_log->day    = DEC_TO_BCD(dec_day);     // 20→0x20（BCD）
1144   1          event_log->hour   = DEC_TO_BCD(dec_hour);    // 15→0x15（BCD）
1145   1          event_log->minute = DEC_TO_BCD(dec_minute);  // 30→0x30（BCD）
1146   1          event_log->second = DEC_TO_BCD(dec_second);  // 45→0x45（BCD）
1147   1      }
