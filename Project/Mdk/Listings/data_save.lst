 328           */
 329          static uint32_t DateTime_To_TimeStamp(const Date_Struct *date, const Time_Struct *time) {
 330   1          uint32_t total_sec = 0;
 331   1          uint16_t full_year = BASE_YEAR + date->year;  /* 后两位年份→完整年份（如25→2025） */
 332   1          uint16_t year;
 333   1          uint8_t month;
 334   1      
 335   1          /* 1. 累加基准年到当前年的总秒数（按平年/闰年区分） */
 336   1          for (year = BASE_YEAR; year < full_year; year++) {
 337   2              total_sec += Is_LeapYear(year) ? 366UL * 24 * 3600 : 365UL * 24 * 3600;
 338   2          }
 339   1          /* 2. 累加当前年1月到当前月的总秒数（按当月天数） */
 340   1          for (month = 1; month < date->month; month++) {
 341   2              total_sec += Get_MonthDays(full_year, month) * 24UL * 3600;
 342   2          }
 343   1          /* 3. 累加当前日、时、分、秒的秒数 */
 344   1          total_sec += (date->day - 1) * 24UL * 3600 + time->hour * 3600UL + time->minute * 60UL + time->second;
 345   1          return total_sec;
 346   1      }
