 327          /**
 328           * @brief  将日期时间转换为秒级时间戳（基准：BASE_YEAR-01-01 00:00:00）
 329           * @param  date：日期结构体指针（年/月/日）
 330           * @param  time：时间结构体指针（时/分/秒）
 331           * @return 秒级时间戳（从基准时间到当前时间的总秒数）
 332           */
 333          static uint32_t DateTime_To_TimeStamp(const Date_Struct *date, const Time_Struct *time) {
 334   1          uint32_t total_sec = 0;
 335   1          uint16_t full_year = BASE_YEAR + date->year;  /* 后两位年份→完整年份（如25→2025） */
 336   1          uint16_t year;
 337   1          uint8_t month;
 338   1      
 339   1          /* 1. 累加基准年到当前年的总秒数（按平年/闰年区分） */
 340   1          for (year = BASE_YEAR; year < full_year; year++) {
 341   2              total_sec += Is_LeapYear(year) ? 366UL * 24 * 3600 : 365UL * 24 * 3600;
 342   2          }
 343   1          /* 2. 累加当前年1月到当前月的总秒数（按当月天数） */
 344   1          for (month = 1; month < date->month; month++) {
 345   2              total_sec += Get_MonthDays(full_year, month) * 24UL * 3600;
 346   2          }
 347   1          /* 3. 累加当前日、时、分、秒的秒数 */
 348   1          total_sec += (date->day - 1) * 24UL * 3600 + time->hour * 3600UL + time->minute * 60UL + time->second;
 349   1          return total_sec;
 350   1      }
