 657   1      
 658   1          // 4. ²ð·Ö±¾µØ¶ÁÈ¡µÄ24Î»Êý¾Ý
 659   1          high_byte = (rx_data >> 16) & 0xFF;
 660   1          mid_byte  = (rx_data >> 8)  & 0xFF;
 661   1          low_byte  = rx_data & 0xFF;
 662   1      
 663   1          // 5. ±¾µØ¼ÆËãÀÛ¼ÓºÍ
 664   1          sum_local = cmd;                // ÃüÁî×Ö½Ú
 665   1          sum_local += high_byte;         // ¸ß8Î»
 666   1          sum_local += mid_byte;          // ÖÐ8Î»
 667   1          sum_local += low_byte;          // µÍ8Î»
 668   1      
 669   1          // 6. Ð£ÑéÃüÁîºÍÀÛ¼ÓºÍ
