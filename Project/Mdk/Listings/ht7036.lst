 616          /********** Í¨Ñ¶Ð£ÑéºÍº¯Êý£¨µ÷ÓÃµ×²ãº¯Êý¶ÁÈ¡0x2E£© **********/
 617          static u8 Ht7036_Comcheck(u8 num, u32 rx_data, u8 cmd) {
 618   1      
 619   1          u32 check_reg_data = 0;
 620   1          u8 cmd_from_reg = 0;
 621   1          u16 sum_from_reg = 0;
 622   1          u16 sum_local = 0;
 623   1          u8 high_byte = 0, mid_byte = 0, low_byte = 0;
 624   1          u8 ret = SPI_OK;
 625   1          u8 add;
 626   1      
 627   1          // 1. ²ÎÊýÐ£Ñé
 628   1          if (num < 1 || num > 4) {
 629   2              return SPI_PARA_ERR;
 630   2          }
 631   1          
 632   1          if(num<3)
 633   1            add=COMChecksum_Add_7036;
 634   1          else
 635   1            add=COMChecksum_7053;     
 636   1      
 637   1          // 2. µ÷ÓÃ¡¾µ×²ãº¯Êý¡¿¶ÁÈ¡0x2E¼Ä´æÆ÷£¨¹Ø¼ü£º±ÜÃâµ÷ÓÃÒµÎñ²ãº¯Êý£©
 638   1          ret = Ht7036_Spi_Read(num, add, &check_reg_data);
 639   1          if (ret != SPI_OK) {
 640   2              return READ_ERR; // ¶Á0x2EÊ§°Ü
 641   2          }
 642   1      
 643   1          // 3. ²ð·Ö0x2E¼Ä´æÆ÷Êý¾Ý
 644   1          cmd_from_reg = (check_reg_data >> 16) & 0xFF;  // ¸ß8Î»=ÉÏÒ»´ÎÃüÁî
 645   1          sum_from_reg = check_reg_data & 0xFFFF;        // µÍ16Î»=ÀÛ¼ÓºÍ
 646   1      
 647   1          // 4. ²ð·Ö±¾µØ¶ÁÈ¡µÄ24Î»Êý¾Ý
 648   1          high_byte = (rx_data >> 16) & 0xFF;
 649   1          mid_byte  = (rx_data >> 8)  & 0xFF;
 650   1          low_byte  = rx_data & 0xFF;
 651   1      
 652   1          // 5. ±¾µØ¼ÆËãÀÛ¼ÓºÍ
 653   1          sum_local = cmd;                // ÃüÁî×Ö½Ú
 654   1          sum_local += high_byte;         // ¸ß8Î»
 655   1          sum_local += mid_byte;          // ÖÐ8Î»
 656   1          sum_local += low_byte;          // µÍ8Î»
 657   1      
 658   1          // 6. Ð£ÑéÃüÁîºÍÀÛ¼ÓºÍ
 659   1          if (cmd_from_reg != cmd) {
 660   2              return CHECKSUM_ERR;
 661   2          }
 662   1          if (sum_from_reg != sum_local) {
 663   2              return CHECKSUM_ERR;
 664   2          }
 665   1      
 666   1          return OK;
 667   1      }
