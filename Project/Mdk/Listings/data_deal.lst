2221          /* 将目标功率因数转换为目标无功（单位与P/Q一致，×100） */
2222          /* P: 有功（>0，×100），cos100: 1～100，is_lead: 0=滞后, 1=超前 */
2223          static long pf_cos_to_q(long P, unsigned char cos100, unsigned char is_lead)
2224          {
2225   1          unsigned int c;
2226   1          unsigned int sq;
2227   1          unsigned int S;
2228   1          long numerator;
