  99          /**
 100           * @brief  CRC8校验值计算函数（工业标准多项式）
 101           * @param  sdata：待校验数据的首地址指针
 102           * @param  len：待校验数据的长度（字节）
 103           * @return 计算后的CRC8校验值（uint8_t）
 104           * @note   多项式：0x31（x^8+x^5+x^4+1），初始值：0xFF，无反码输出
 105           */
 106           uint8_t CRC8_Calc(const uint8_t *sdata, uint16_t len) {
 107   1          uint8_t crc = CRC8_INIT;
 108   1          uint16_t i, j;  /* C89要求：循环变量必须在函数开头声明 */
 109   1          for (i = 0; i < len; i++) {
 110   2              crc ^= sdata[i];  /* 数据与CRC异或 */
 111   2              for (j = 0; j < 8; j++) {
 112   3                  /* 按位计算CRC：最高位为1则左移并异或多项式，否则仅左移 */
 113   3                  crc = (crc & 0x80) ? ((crc << 1) ^ CRC8_POLY) : (crc << 1);
 114   3              }
 115   2          }
