 373   3                      g_beep_alarm_timer = 0;
 374   3                      break;
 375   3      
 376   3                  case 61: // 常开报警：不自动关闭，计时置0标记
 377   3                      g_relay_state |= BEEP_ON;
 378   3                      g_beep_alarm_timer = 0; // 0表示常开状态
 379   3                      break;
 380   3      
