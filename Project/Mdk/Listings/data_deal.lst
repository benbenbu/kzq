  11           * @brief  CRC8校验值计算函数（工业标准多项式）
  12           * @param  sdata：待校验数据的首地址指针
  13           * @param  len：待校验数据的长度（字节）
  14           * @return 计算后的CRC8校验值（uint8_t）
  15           * @note   多项式：0x31（x^8+x^5+x^4+1），初始值：0xFF，无反码输出
  16           */
  17           uint8_t CRC8_Calc(const uint8_t *sdata, uint16_t len) {
  18   1          uint8_t crc = CRC8_INIT;
  19   1          uint16_t i, j;  /* C89要求：循环变量必须在函数开头声明 */
  20   1          for (i = 0; i < len; i++) {
  21   2              crc ^= sdata[i];  /* 数据与CRC异或 */
  22   2              for (j = 0; j < 8; j++) {
  23   3                  /* 按位计算CRC：最高位为1则左移并异或多项式，否则仅左移 */
  24   3                  crc = (crc & 0x80) ? ((crc << 1) ^ CRC8_POLY) : (crc << 1);
  25   3              }
  26   2          }
  27   1          return crc;
  28   1      }
