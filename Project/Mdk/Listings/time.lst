  70   1          TH0 = (reload_value >> 8) & 0xFF;
  71   1          TL0 = reload_value & 0xFF;
  72   1          
  73   1          // 更新配置
  74   1          timer_configs[0].state = TIMER_ENABLED;
  75   1          timer_configs[0].period_ms = period_ms;
  76   1          timer_configs[0].target_count = period_ms;
  77   1          timer_configs[0].callback_enabled = (callback != 0);
