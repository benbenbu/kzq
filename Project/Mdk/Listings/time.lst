 150          uint32_t Get_SystemTime(void) {
 151   1          uint32_t temp_time;
 152   1          uint8_t SFRPAGE_SAVE = SFRPAGE;
 153   1          
 154   1          EA = 0; // 关闭总中断（仅耗时2条指令，几乎不影响其他中断）
 155   1          // 也可仅关闭定时器0中断：ET0 = 0; （更精准，不影响ADC/定时器1中断）
 156   1          temp_time = system_time_ms;
 157   1          EA = 1; // 恢复总中断
 158   1      
 159   1          SFRPAGE = SFRPAGE_SAVE;
 160   1          return temp_time;
 161   1      }
