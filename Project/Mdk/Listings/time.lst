 200          // 停止指定定时器
 201          void Timer_Stop(uint8_t timer_num) {
 202   1          if(timer_num >= 5) return;
 203   1          
 204   1          switch(timer_num) {
 205   2              case 0:
 206   2                  TR0 = 0;    // 停止定时器0
 207   2                  ET0 = 0;    // 禁止定时器0中断
 208   2                  break;
 209   2              case 1:
 210   2                  TR1 = 0;    // 停止定时器1
 211   2                  ET1 = 0;    // 禁止定时器1中断
 212   2                  break;
 213   2              case 2:
 214   2                  TR2 = 0;    // 停止定时器2
 215   2                  ET2 = 0;    // 禁止定时器2中断
 216   2                  break;
 217   2              case 3:
 218   2                  TR3 = 0;    // 停止定时器3
 219   2      //            ET3 = 0;    // 禁止定时器3中断
 220   2                  EIE2&=~0X01;
 221   2                  break;
 222   2              case 4:
 223   2                  TR4 = 0;    // 停止定时器4
 224   2      //            ET4 = 0;    // 禁止定时器4中断
 225   2                  EIE2&=~0X04;        
 226   2                  break;
 227   2          }
 228   1          
 229   1      
 230   1      }
