             -r) {
 274   1          int dx, dy, sx, sy, err, e2;
 275   1          
 276   1          // 计算x和y方向的差值
 277   1          dx = (x1 < x2) ? (x2 - x1) : (x1 - x2);
 278   1          dy = (y1 < y2) ? (y2 - y1) : (y1 - y2);
 279   1          
